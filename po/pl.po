#: properties/nm-openvpn3-dialog.ui:2803 properties/nm-openvpn3-dialog.ui:2857
#: properties/nm-openvpn3-dialog.ui:2910 properties/nm-openvpn3-dialog.ui:2963
#: properties/nm-openvpn3-editor.c:2597
msgid "_Cancel"
msgstr "_Anuluj"

#: properties/nm-openvpn3-dialog.ui:936
msgid "_Apply"
msgstr "_Zastosuj"

#: properties/nm-openvpn3-dialog.ui:998
msgid "Use custom gateway p_ort"
msgstr "Własny port bra_my"

#: properties/nm-openvpn3-dialog.ui:1002 properties/nm-openvpn3-dialog.ui:1017
msgid ""
"TCP/UDP port number for peer. (Default value when there is no port for "
"gateway).\n"
"config: port"
msgstr ""
"Numer portu TCP/UDP dla partnera (domyślna wartość, kiedy nie ma portu dla "
"bramy).\n"
"konfiguracja: port"

#: properties/nm-openvpn3-dialog.ui:1043
msgid "Use custom _renegotiation interval"
msgstr "Własny czas między ponownymi _negocjacjami"

#: properties/nm-openvpn3-dialog.ui:1047 properties/nm-openvpn3-dialog.ui:1062
msgid ""
"Renegotiate data channel key after the specified number of seconds.\n"
"config: reneg-sec"
msgstr ""
"Renegocjuje klucz kanał danych po podanej liczbie sekund.\n"
"konfiguracja: reneg-sec"

#: properties/nm-openvpn3-dialog.ui:1083
msgid "Use a _TCP connection"
msgstr "Połączenie _TCP"

#: properties/nm-openvpn3-dialog.ui:1087
msgid ""
"Use TCP for communicating with remote host.\n"
"(This is a default setting only used when no protocol is specified for the "
"gateway.)\n"
"config: proto tcp-client | udp"
msgstr ""
"Używa TCP do komunikowania się ze zdalnym komputerem\n"
"(domyślne ustawienie używane tylko, kiedy nie podano protokołu dla "
"bramy).konfiguracja: proto tcp-client | udp"

#: properties/nm-openvpn3-dialog.ui:1106
