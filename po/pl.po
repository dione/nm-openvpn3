msgstr "Bezpośrednio ustawia typ i nazwę urządzenia wirtualnego (TUN/TAP)."

#: properties/nm-openvpn3-dialog.ui:1124
msgid ""
"Explicitly set virtual device type (TUN/TAP).\n"
"config: dev-type tun | tap"
msgstr ""
"Bezpośrednio ustawia typ urządzenia wirtualnego (TUN/TAP).\n"
"konfiguracja: dev-type tun | tap"

#: properties/nm-openvpn3-dialog.ui:1144
msgid " and _name"
msgstr " i _nazwa"

#: properties/nm-openvpn3-dialog.ui:1159
msgid ""
"Use custom name for TUN/TAP virtual device (instead of default “tun” or "
"“tap”).\n"
