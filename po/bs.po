msgstr ""

msgid "0 leaves the value at openvpn's default (1194)."
msgstr ""

msgid "CA certificate"
msgstr ""

msgid "PEM-encoded certificate authority that signs the server."
msgstr ""

msgid "User certificate"
msgstr ""

msgid "PEM-encoded client certificate."
msgstr ""

