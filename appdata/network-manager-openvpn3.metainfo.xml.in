<component type="addon">
  <id>network-manager-openvpn3</id>
  <project_license>GPL-2.0+</project_license>
  <metadata_license>CC0-1.0</metadata_license>
  <extends>nm-connection-editor.desktop</extends>
  <extends>org.gnome.Settings.desktop</extends>
  <extends>gnome-control-center.desktop</extends>
  <name>OpenVPN 3 client</name>
  <summary>Client for OpenVPN 3 virtual private networks</summary>

  <keywords>
    <keyword>network</keyword>
    <keyword>manager</keyword>
    <keyword>NetworkManager</keyword>
    <keyword>connection</keyword>
    <keyword>VPN</keyword>
    <keyword>OpenVPN</keyword>
  </keywords>

  <description>
    <p>Support for configuring OpenVPN 3 virtual private network connections.</p>
    <p>OpenVPN 3 is a modern, D-Bus-based VPN solution using the OpenVPN 3 Core library.</p>
  </description>

  <screenshots>
    <screenshot type="default">
      <image width="800" height="658">https://raw.githubusercontent.com/dione/nm-openvpn3/fork/openvpn3-skeleton/appdata/openvpn.png</image>
    </screenshot>
    <screenshot>
      <caption>The advanced options dialog</caption>
      <image width="800" height="604">https://raw.githubusercontent.com/dione/nm-openvpn3/fork/openvpn3-skeleton/appdata/openvpn-advanced.png</image>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/dione/nm-openvpn3</url>
  <url type="bugtracker">https://github.com/dione/nm-openvpn3/issues</url>
  <!-- TODO: replace with a real maintainer address before any AppStream
       submission.  AppStream uses _AT_ in lieu of @ to deter scrapers. -->
  <update_contact>nm-openvpn3-maint_AT_users.noreply.github.com</update_contact>
  <translation type="gettext">NetworkManager-openvpn3</translation>
  <developer_name>The nm-openvpn3 fork authors</developer_name>
</component>
