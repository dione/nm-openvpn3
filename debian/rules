#!/usr/bin/make -f
# dh-cargo path — resolves Rust deps via `librust-*-dev` packages from
# the Debian / Ubuntu archive.  No vendor/ tree, no `cargo --offline`.
#
# We do NOT use `--buildsystem cargo` because dh-cargo's default flow
# assumes a single-crate source package with `debian/cargo-checksum.json`
# (the layout `debcargo` produces).  Our workspace builds two bins +
# two cdylibs from one source tree, so we drive cargo through the
# workspace Makefile and only borrow dh-cargo's apt-installed crate
# registry under /usr/share/cargo/registry.

include /usr/share/dpkg/architecture.mk
LIBDIR := /usr/lib/$(DEB_HOST_MULTIARCH)

# CARGO_HOME hosts the offline config that points at the archive's
# crate registry.  No network access during the build.
export CARGO_HOME = $(CURDIR)/debian/cargo_home

%:
	dh $@

override_dh_auto_configure:
	mkdir -p $(CARGO_HOME)
	{ \
	    echo '[source.crates-io]'; \
	    echo 'replace-with = "vendored-sources"'; \
	    echo ''; \
	    echo '[source.vendored-sources]'; \
	    echo 'directory = "/usr/share/cargo/registry"'; \
	    echo ''; \
	    echo '[net]'; \
	    echo 'offline = true'; \
	} > $(CARGO_HOME)/config.toml

override_dh_auto_build:
	# Cargo.lock pins exact upstream versions; the apt archive ships
	# slightly older patches (eg. anyhow 1.0.101 vs locked 1.0.102).
	# Drop the lock so cargo resolves against the archive — the build
	# tree's Cargo.lock comes back at clean time via override_dh_auto_clean.
	# Reproducibility comes from the apt archive snapshot, not Cargo.lock.
	rm -f Cargo.lock
	$(MAKE) build CARGO_FLAGS='--release --workspace'

override_dh_auto_test:
	@echo "Skipping cargo test on Launchpad — re-enable for local runs."

override_dh_auto_install:
	$(MAKE) install \
	    DESTDIR=$(CURDIR)/debian/tmp \
	    libdir=$(LIBDIR) \
	    pluginlibdir=$(LIBDIR)/NetworkManager

override_dh_auto_clean:
	$(MAKE) clean
	rm -rf target debian/cargo_home
	# Restore the committed Cargo.lock if the build replaced it with
	# an apt-resolved variant.  Ignore failure when we're not inside
	# a git checkout (eg. an unpacked .dsc on a Launchpad builder).
	git checkout -- Cargo.lock 2>/dev/null || true

override_dh_strip:
	dh_strip --no-automatic-dbgsym
