[VPN Connection]
name=openvpn3.rust
service=org.freedesktop.NetworkManager.openvpn3.rust
program=@LIBEXECDIR@/nm-openvpn3-rust-service
supports-multiple-connections=true
supports-safe-private-file-access=true

# [libnm] / [GNOME].properties intentionally left out.
#
# The C tree ships `libnm-vpn-plugin-openvpn3.so` (libnm discovery
# stub) and `libnm-vpn-plugin-openvpn3-editor.so` (GTK editor),
# both hard-coded against the C service name
# `org.freedesktop.NetworkManager.openvpn3`.  Pointing this .name
# at those .so files makes gnome-control-center (and nm-applet's
# editor) log "invalid service name" on every refresh because the
# Rust service-type doesn't match what those libraries advertise.
#
# The runtime path (Connect / Disconnect / SecretsRequired) does
# not use these .so files; NM dispatches the auth-dialog binary
# from [GNOME] auth-dialog= directly.  Until the Rust port grows
# its own libnm-vpn-plugin cdylib, omit the editor wiring so the
# GUI editor cleanly says "no editor available" instead of
# spamming a confusing load error.

[GNOME]
auth-dialog=@LIBEXECDIR@/nm-openvpn3-rust-auth-dialog
supports-external-ui-mode=true
supports-hints=true
