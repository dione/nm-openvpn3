# Editor / OS junk
*~
*.swp
.DS_Store

# Rust build output
/target/
**/target/

# coderabbit local review file (contains workingDirectory PII)
/coderabbit-review.jsonl

# Fork-local working notes — not part of the upstream tree
/reference/
/docs/superpowers/

# gettext compile output (built by Makefile install-i18n target,
# regenerated on every build).
/po/*.mo

# Debian packaging artefacts.  vendor/ arrives via the orig-vendor
# component tarball at debuild time; cargo_home holds the offline
# config debian/rules drops in.  All three are regenerated by the
# build, none belong in git.
/vendor/
/debian/cargo_home/
/debian/tmp/
/debian/.debhelper/
/debian/files
/debian/*.substvars
/debian/*.debhelper.log
/debian/*.debhelper
/debian/network-manager-openvpn3/
/debian/network-manager-openvpn3-gnome/
/debian/debhelper-build-stamp
